<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Album Art, Compact Title & Artist, Play/Pause -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_square_album_art"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_album_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_square_track_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_square_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Track Playing"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_square_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spotify Controller"
                android:textColor="#A0A0B0"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_square_btn_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Play or Pause"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>

    <!-- Subtle divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1AFFFFFF" />

    <!-- 2-Line Synced Lyrics for 2x2 Square Widget -->
    <LinearLayout
        android:id="@+id/widget_square_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Active Time-Synced Line -->
        <LinearLayout
            android:id="@+id/widget_square_active_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_active_line_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_widget_lyrics" />

            <TextView
                android:id="@+id/widget_square_lyric_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tap to open live lyrics"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next Lyric Line -->
        <TextView
            android:id="@+id/widget_square_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
