<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Top Bar: Track Info & Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_exp_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:src="@drawable/widget_album_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_exp_track_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_exp_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Track Playing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_exp_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spotify Controller"
                android:textColor="#B0B0C4"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Media Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_exp_btn_prev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous Track"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/widget_exp_btn_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Play or Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_exp_btn_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next Track"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#1AFFFFFF" />

    <!-- 5-Line Time-Synced Lyrics Container -->
    <LinearLayout
        android:id="@+id/widget_exp_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Line -2 -->
        <TextView
            android:id="@+id/widget_exp_lyric_prev_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#40FFFFFF"
            android:textSize="11sp" />

        <!-- Line -1 -->
        <TextView
            android:id="@+id/widget_exp_lyric_prev_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#73FFFFFF"
            android:textSize="11sp" />

        <!-- Active Line (Prominent Pill) -->
        <LinearLayout
            android:id="@+id/widget_exp_active_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:background="@drawable/widget_active_line_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_lyrics" />

            <TextView
                android:id="@+id/widget_exp_lyric_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open live lyrics"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line +1 -->
        <TextView
            android:id="@+id/widget_exp_lyric_next_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#73FFFFFF"
            android:textSize="11sp" />

        <!-- Line +2 -->
        <TextView
            android:id="@+id/widget_exp_lyric_next_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#40FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
