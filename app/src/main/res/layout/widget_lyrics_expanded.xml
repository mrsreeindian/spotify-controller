<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Metadata & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_exp_album_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_album_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_exp_track_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_exp_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Track Playing"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_exp_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spotify Controller"
                android:textColor="#A0A0B0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Media Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_exp_btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous Track"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/widget_exp_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Play or Pause"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_exp_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next Track"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expanded 5-Line Lyrics Stream -->
    <LinearLayout
        android:id="@+id/widget_exp_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Line -2 -->
        <TextView
            android:id="@+id/widget_exp_lyric_prev_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#3DFFFFFF"
            android:textSize="11sp" />

        <!-- Line -1 -->
        <TextView
            android:id="@+id/widget_exp_lyric_prev_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#7AFFFFFF"
            android:textSize="12sp" />

        <!-- Active Line (Prominent) -->
        <LinearLayout
            android:id="@+id/widget_exp_active_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_active_line_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_widget_lyrics" />

            <TextView
                android:id="@+id/widget_exp_lyric_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tap to open live lyrics"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line +1 -->
        <TextView
            android:id="@+id/widget_exp_lyric_next_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#7AFFFFFF"
            android:textSize="12sp" />

        <!-- Line +2 -->
        <TextView
            android:id="@+id/widget_exp_lyric_next_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#3DFFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Bottom Footer Pill -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Time-Synced Lyrics"
        android:textColor="#40FFFFFF"
        android:textSize="9sp" />

</LinearLayout>
