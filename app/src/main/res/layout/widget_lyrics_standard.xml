<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="11dp">

    <!-- Top Bar: Track Info & Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_album_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_track_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Track Playing"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spotify Controller"
                android:textColor="#A0A0B0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Media Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous Track"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Play or Pause"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next Track"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="5dp"
        android:background="#1AFFFFFF" />

    <!-- Synced Lyrics 3-Line Card Container -->
    <LinearLayout
        android:id="@+id/widget_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Previous Lyric Line -->
        <TextView
            android:id="@+id/widget_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <!-- Current Active Time-Synced Lyric Line -->
        <LinearLayout
            android:id="@+id/widget_active_line_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:background="@drawable/widget_active_line_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_widget_lyrics" />

            <TextView
                android:id="@+id/widget_lyric_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open live lyrics"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next Lyric Line -->
        <TextView
            android:id="@+id/widget_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
