<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Album Art -->
    <ImageView
        android:id="@+id/widget_compact_album_art"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/widget_album_art_placeholder" />

    <!-- Center: Track Title & Time-Synced Active Lyric Line -->
    <LinearLayout
        android:id="@+id/widget_compact_lyrics_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No Track Playing"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_lyrics" />

            <TextView
                android:id="@+id/widget_compact_active_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open live lyrics"
                android:textColor="#1DB954"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_compact_btn_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Previous Track"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_previous" />

        <ImageButton
            android:id="@+id/widget_compact_btn_play_pause"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Play or Pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_compact_btn_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Next Track"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>

</LinearLayout>
