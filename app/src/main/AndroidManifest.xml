<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SpotifyControllerApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_media_play"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotifyController">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SpotifyController">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Spotify OAuth Redirect Deep Link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="spotifycontroller"
                    android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Time-Synced Lyrics Resizable Home Screen Widget -->
        <receiver
            android:name=".widget.LyricsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.spotify.controller.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.spotify.controller.widget.ACTION_NEXT" />
                <action android:name="com.spotify.controller.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyrics_widget_info" />
        </receiver>

        <!-- Time-Synced Lyrics 4x4 Home Screen Widget -->
        <receiver
            android:name=".widget.Lyrics4x4WidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.spotify.controller.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.spotify.controller.widget.ACTION_NEXT" />
                <action android:name="com.spotify.controller.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyrics_widget_4x4_info" />
        </receiver>
    </application>

</manifest>
